# RStudio
.Rproj.user
.Rhistory
.RData
.Ruserdata

# Raw Vizathon files: downloaded by scr/01_download_data.R, never committed
input/*
!input/.gitkeep
# Reference tables written by hand, such as the GPS glossary, are committed
!input/reference/

# Built by the pipeline, rebuilt from one command
data/*
!data/.gitkeep
_targets/
*.duckdb
*.duckdb.wal

# Deployment records (account details)
rsconnect/

# Quarto render leftovers
docs/*_files/
.quarto/


/.quarto/
**/*.quarto_ipynb
